{
  "manifest_version": 3,
  "name": "AntiPoop - FB Algorithm Cleaner",
  "version": "1.0.0",
  "description": "Oculta posts del feed de Facebook que contengan ciertas keywords (nombres de influencers, hashtags, etc).",
  "permissions": ["storage"],
  "host_permissions": ["*://*.facebook.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
